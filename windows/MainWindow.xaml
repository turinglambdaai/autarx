<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Autarx">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AutarxSidebarBrush" Color="#F3F2F1" />
                        <SolidColorBrush x:Key="AutarxSurfaceBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AutarxDividerBrush" Color="#E1DFDD" />
                        <SolidColorBrush x:Key="AutarxSelectedBrush" Color="#EFE7E2" />
                        <SolidColorBrush x:Key="AutarxAccentBrush" Color="#C15F3C" />
                        <SolidColorBrush x:Key="AutarxAccentSoftBrush" Color="#14C15F3C" />
                        <SolidColorBrush x:Key="AutarxWarnBrush" Color="#B0681E" />
                        <SolidColorBrush x:Key="AutarxSecondaryTextBrush" Color="#797775" />
                        <SolidColorBrush x:Key="AutarxMutedTextBrush" Color="#A19F9D" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AutarxSidebarBrush" Color="#272424" />
                        <SolidColorBrush x:Key="AutarxSurfaceBrush" Color="#323234" />
                        <SolidColorBrush x:Key="AutarxDividerBrush" Color="#3B3939" />
                        <SolidColorBrush x:Key="AutarxSelectedBrush" Color="#3D342F" />
                        <SolidColorBrush x:Key="AutarxAccentBrush" Color="#E08D6D" />
                        <SolidColorBrush x:Key="AutarxAccentSoftBrush" Color="#14E08D6D" />
                        <SolidColorBrush x:Key="AutarxWarnBrush" Color="#D8A24E" />
                        <SolidColorBrush x:Key="AutarxSecondaryTextBrush" Color="#A8A5A3" />
                        <SolidColorBrush x:Key="AutarxMutedTextBrush" Color="#7A7775" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File" x:Name="MenuFile">
                <MenuFlyoutItem x:Name="MenuOpenFolder" Click="OnOpenFolder">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuOpenFile" Click="OnOpenFile" />
                <MenuFlyoutItem x:Name="MenuCloseWorkspace" Click="OnCloseWorkspace" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuExit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem Title="Help" x:Name="MenuHelp">
                <MenuFlyoutItem x:Name="MenuCheckUpdates" Click="OnCheckUpdates">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="U" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuAbout" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- Body: sidebar | pages + inspector -->
        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="190" MaxWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: workbench sections -->
            <Grid x:Name="SidebarPane" Grid.Column="0" Background="{ThemeResource AutarxSidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="SidebarCaption"
                    Grid.Row="0"
                    Margin="16,14,12,4"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AutarxSecondaryTextBrush}" />
                <ListView
                    x:Name="NavList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    SelectionChanged="OnNavSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="36" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <Border
                x:Name="SidebarDivider"
                Grid.Column="1"
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource AutarxDividerBrush}" />

            <!-- Content: pages | inspector -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="Pages" Grid.Column="0">
                    <!-- Workspace summary -->
                    <Grid x:Name="WorkspacePanel">
                        <ScrollViewer Padding="24,16,24,16" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SummaryList" MaxWidth="720" HorizontalAlignment="Stretch" />
                        </ScrollViewer>
                        <StackPanel
                            x:Name="WorkspaceEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="28"
                                Foreground="{ThemeResource AutarxMutedTextBrush}"
                                Text="&#xE7B8;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="No workspace" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource AutarxSecondaryTextBrush}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Text="Open an OEM delivery directory or a single ARXML file (Ctrl+O) to index it." />
                        </StackPanel>
                    </Grid>

                    <!-- Objects -->
                    <Grid x:Name="ObjectsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SearchBox"
                                Height="30"
                                CornerRadius="8"
                                VerticalContentAlignment="Center"
                                PlaceholderText="Filter by SHORT-NAME"
                                KeyDown="OnSearchKeyDown" />
                            <Button
                                x:Name="FindButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="OnFindClick" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ListView
                                x:Name="ObjectList"
                                Margin="16,0,16,16"
                                SelectionMode="Single"
                                SelectionChanged="OnObjectSelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="44" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </ScrollViewer>
                    </Grid>

                    <!-- ECUs -->
                    <Grid x:Name="EcusPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListView
                                x:Name="EcuList"
                                Margin="16,12,16,16"
                                SelectionMode="Single"
                                SelectionChanged="OnEcuSelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="44" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </ScrollViewer>
                    </Grid>

                    <!-- Unresolved references -->
                    <Grid x:Name="UnresolvedPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListView
                                x:Name="UnresolvedList"
                                Margin="16,12,16,16"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </ScrollViewer>
                    </Grid>

                    <!-- Communication -->
                    <Grid x:Name="CommPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListView
                                x:Name="CommList"
                                Margin="16,12,16,16"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Border
                    x:Name="InspectorDivider"
                    Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AutarxDividerBrush}" />

                <!-- Inspector: selected object + its references -->
                <Grid x:Name="InspectorPanel" Grid.Column="2" Background="{ThemeResource AutarxSidebarBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="14,14,14,8" Spacing="2">
                        <TextBlock
                            x:Name="InspectorTitle"
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Text="Inspector" />
                        <TextBlock
                            x:Name="InspectorSubtitle"
                            FontSize="12"
                            Foreground="{ThemeResource AutarxSecondaryTextBrush}" />
                        <TextBlock
                            x:Name="InspectorPath"
                            FontSize="11"
                            FontFamily="Consolas"
                            Foreground="{ThemeResource AutarxSecondaryTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,0,14,14">
                            <TextBlock
                                Margin="0,4,0,6"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AutarxSecondaryTextBrush}"
                                Text="References" />
                            <ListView x:Name="InspectorRefs" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Padding" Value="2,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{ThemeResource AutarxSidebarBrush}">
            <TextBlock
                x:Name="StatusText"
                Margin="12,4"
                FontSize="12"
                Foreground="{ThemeResource AutarxSecondaryTextBrush}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Progress capsule (long backend operations surface the progress
             event; the same floating chip the macOS workbench overlays) -->
        <Border
            x:Name="ProgressCapsule"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,16"
            Padding="12,6"
            CornerRadius="10"
            Background="{ThemeResource AutarxSurfaceBrush}"
            BorderBrush="{ThemeResource AutarxDividerBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ProgressText"
                FontSize="12"
                Foreground="{ThemeResource AutarxSecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
